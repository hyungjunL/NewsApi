<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ddi.newsapi.repository.NewsArticleMapper">

    <!-- [공통] 필터 조건을 위한 SQL 조각 -->
    <!-- 이 조각을 재사용하여 코드 중복을 줄입니다. -->
    <sql id="filterConditions">
        <where>
            <!-- 사이트 목록으로 필터링 -->
            <if test="sites != null and !sites.isEmpty()">
                AND source IN
                <foreach item="site" collection="sites" open="(" separator="," close=")">
                    #{site}
                </foreach>
            </if>

            <!-- 키워드 목록으로 필터링 -->
            <if test="keywords != null and !keywords.isEmpty()">
                AND (
                <foreach item="keyword" collection="keywords" separator=" OR ">
                    title LIKE '%' || #{keyword} || '%' OR summary LIKE '%' || #{keyword} || '%'
                </foreach>
                )
            </if>
        </where>
    </sql>

    <!-- [수정] 페이징 처리를 위한 목록 조회 쿼리 -->
    <select id="findArticlesBySettings" resultType="com.ddi.newsapi.model.NewsArticle">
        SELECT
        id, title, link, summary, source, pub_date, reg_date
        FROM
        news
        <!-- 위에서 정의한 SQL 조각을 포함시킵니다. -->
        <include refid="filterConditions"/>
        ORDER BY id DESC
        <!-- [수정] 고정된 LIMIT 100 대신 동적인 파라미터를 사용합니다. -->
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <!-- [신규] 페이징 처리를 위한 전체 개수 조회 쿼리 -->
    <select id="countArticlesBySettings" resultType="long">
        SELECT
        COUNT(*)
        FROM
        news
        <!-- 동일한 필터 조건을 재사용합니다. -->
        <include refid="filterConditions"/>
    </select>

</mapper>